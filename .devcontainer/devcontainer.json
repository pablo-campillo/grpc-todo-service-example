{
	"name": "todo",
	"dockerComposeFile": [
		"docker-compose.yaml"
	],
	"service": "dev",
  	"remoteUser": "vscode",
  	"workspaceFolder": "/workspaces/grpc-todo-service-example",
	"features": {
		"ghcr.io/eitsupi/devcontainer-features/go-task:1": {}
	},
	"postCreateCommand": "/workspaces/grpc-todo-service-example/.devcontainer/post-create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"task.vscode-task",
				"golang.go",
				"redhat.vscode-yaml",
				"zxh404.vscode-proto3"
			]
		}
	},
	"forwardPorts": [
		"dev:50051"    
	],
	"portsAttributes": {
		"dev:50051": {
		"label": "gRPC service"
		}
	}
}